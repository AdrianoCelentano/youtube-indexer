<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup and device transfer rules.

  See backup_rules.xml. The auth preferences are encrypted with a Keystore key that is
  never transferred, so restoring the file alone produces an unreadable blob and a crash
  on first launch.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="yt_indexer_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="yt_indexer_auth.xml" />
    </device-transfer>
</data-extraction-rules>
