-- One row per video on the signed-in user's channel.
--
-- publishedAt is stored as the raw ISO-8601 string YouTube returns rather than an
-- epoch: it sorts correctly as text (fixed-width, UTC, zero-padded) and avoids a
-- timezone-parsing dependency in commonMain. Ordering and range filters still work.
--
-- tags is a newline-joined string. A separate tags table would be more normalised, but
-- tags are only ever read back with their video and matched by full-text search, so a
-- join table would add cost without buying anything.
CREATE TABLE Video (
    videoId         TEXT NOT NULL PRIMARY KEY,
    title           TEXT NOT NULL,
    description     TEXT NOT NULL,
    publishedAt     TEXT NOT NULL,
    thumbnailUrl    TEXT,
    tags            TEXT NOT NULL DEFAULT '',
    categoryId      TEXT,
    durationSeconds INTEGER,
    indexedAt       INTEGER NOT NULL,
    -- Stable hash of title+description+tags. Lets a later embedding pass tell whether a
    -- video's *content* changed, not merely when it was last fetched: without it, editing
    -- a description would leave a stale vector pointing at the old meaning with nothing
    -- to flag it.
    contentHash     TEXT,
    -- Which embedding model produced the stored vector. Switching models invalidates
    -- every vector, and without this there is no way to tell which are stale.
    embeddingModel  TEXT,
    -- Plain text of the video's captions, timestamps stripped. NULL means not fetched:
    -- at 250 quota units each, transcripts backfill over days, so most rows are NULL
    -- most of the time.
    transcript      TEXT,
    transcriptFetchedAt INTEGER,
    -- Set even when no captions exist, so a video without them is not retried forever
    -- at 50 units per attempt.
    transcriptAttemptedAt INTEGER
);

-- Category browse and the category filter both sort by recency within a category.
CREATE INDEX video_category_published ON Video(categoryId, publishedAt DESC);
CREATE INDEX video_published ON Video(publishedAt DESC);

-- INSERT OR REPLACE rather than ON CONFLICT DO UPDATE: UPSERT needs SQLite 3.24,
-- which only arrived in Android API 30, and this module targets minSdk 24. Since every
-- column is supplied on every write, REPLACE is semantically identical here.
upsert:
INSERT OR REPLACE INTO Video(videoId, title, description, publishedAt, thumbnailUrl, tags, categoryId, durationSeconds, indexedAt, contentHash, embeddingModel)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?,
    -- Preserve any existing embeddingModel: REPLACE would otherwise null it on every
    -- re-index, silently orphaning vectors that are still valid.
    (SELECT embeddingModel FROM Video WHERE videoId = ?));

selectById:
SELECT * FROM Video WHERE videoId = ?;

selectAll:
SELECT * FROM Video ORDER BY publishedAt DESC LIMIT :limit OFFSET :offset;

selectByCategory:
SELECT * FROM Video WHERE categoryId = ? ORDER BY publishedAt DESC LIMIT :limit OFFSET :offset;

-- Categories that actually have indexed videos, so the filter UI never offers an
-- empty category.
selectPopulatedCategoryIds:
SELECT categoryId, COUNT(*) AS videoCount
FROM Video
WHERE categoryId IS NOT NULL
GROUP BY categoryId
ORDER BY videoCount DESC;

countAll:
SELECT COUNT(*) FROM Video;

-- Newest publishedAt already stored; the incremental sync stops once it reaches this.
maxPublishedAt:
SELECT MAX(publishedAt) FROM Video;

deleteById:
DELETE FROM Video WHERE videoId = ?;

-- Mark-and-sweep prune. A completed full index stamps every surviving video with the
-- run's start time, so anything older was not returned by YouTube this run and has been
-- deleted or made private upstream.
deleteIndexedBefore:
DELETE FROM Video WHERE indexedAt < ?;

-- Records which model produced a video's vector.
markEmbedded:
UPDATE Video SET embeddingModel = ? WHERE videoId = ?;

storeTranscript:
UPDATE Video
SET transcript = ?, transcriptFetchedAt = ?, transcriptAttemptedAt = ?, contentHash = ?
WHERE videoId = ?;

-- Records an attempt that produced nothing, so it is not retried on every pass.
markTranscriptUnavailable:
UPDATE Video SET transcriptAttemptedAt = ? WHERE videoId = ?;

-- Backfill order: newest first, and never re-attempt a video already tried.
selectNeedingTranscript:
SELECT * FROM Video
WHERE transcriptAttemptedAt IS NULL
ORDER BY publishedAt DESC
LIMIT :limit;

countWithTranscript:
SELECT COUNT(*) FROM Video WHERE transcript IS NOT NULL;

-- Videos whose text has changed since their vector was built, plus those never embedded.
selectNeedingEmbedding:
SELECT * FROM Video WHERE embeddingModel IS NULL OR embeddingModel != ? LIMIT :limit;

deleteAll:
DELETE FROM Video;

-- Ids about to be pruned, so their search rows can be removed in the same transaction.
selectIndexedBefore:
SELECT videoId FROM Video WHERE indexedAt < ?;
