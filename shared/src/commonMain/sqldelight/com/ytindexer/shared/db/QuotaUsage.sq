-- Units of YouTube API quota spent, bucketed by Pacific calendar day.
--
-- Persisted rather than held in memory because the budget must survive process death:
-- an in-memory counter would reset on every app restart and let a caption backfill spend
-- the daily allowance several times over.
CREATE TABLE QuotaUsage (
    pacificDay TEXT NOT NULL PRIMARY KEY,
    unitsUsed  INTEGER NOT NULL DEFAULT 0
);

recordUsage:
INSERT OR REPLACE INTO QuotaUsage(pacificDay, unitsUsed)
VALUES (?, COALESCE((SELECT unitsUsed FROM QuotaUsage WHERE pacificDay = ?), 0) + ?);

usedOn:
SELECT COALESCE((SELECT unitsUsed FROM QuotaUsage WHERE pacificDay = ?), 0) AS units;

-- Old buckets are useless once the day rolls over; keeps the table from growing forever.
deleteOlderThan:
DELETE FROM QuotaUsage WHERE pacificDay < ?;
